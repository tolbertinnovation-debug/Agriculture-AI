# Copy to .env and fill in. Every value has a development default.
AGRI_ENV=development              # set to production to enforce the checks below
AGRI_DATABASE_URL=sqlite:///./agri_ai.db
AGRI_ADMIN_TOKEN=change-me        # platform operator token (X-Admin-Token)
AGRI_SECRET_KEY=change-me         # signs farmer app sessions
AGRI_WEBHOOK_SECRET=change-me     # shared with your SMS/USSD/WhatsApp gateway
AGRI_DEV_EXPOSE_OTP=1             # shows login codes in API responses; forced off in production

# AI (photo diagnosis and conversational advice). Without a key the rule-based fallback is used.
ANTHROPIC_API_KEY=
AGRI_LLM_MODEL=claude-opus-5-5
AGRI_LLM_EFFORT=medium
AGRI_AI_DAILY_LIMIT=20            # model calls per farmer per day

# Outbound SMS: console | africastalking | twilio
AGRI_SMS_GATEWAY=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AGRI_MEDIA_HOST_ALLOWLIST=api.twilio.com,media.twiliocdn.com,lookaside.fbsbx.com

# Weather: open-meteo (free, no key) | static (offline demo)
AGRI_WEATHER_PROVIDER=open-meteo
AGRI_WEATHER_CACHE_MINUTES=180

AGRI_UPLOAD_DIR=./uploads
AGRI_REVIEW_CONFIDENCE_THRESHOLD=0.6
AGRI_OUTBREAK_MIN_REPORTS=3
AGRI_OUTBREAK_RADIUS_KM=25
AGRI_OUTBREAK_WINDOW_DAYS=14
